# Copy to .env.local and replace every placeholder. Never commit the real file.
DB_URL=jdbc:mysql://127.0.0.1:3306/river_agi?useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
DB_USERNAME=river_agi
DB_PASSWORD=change-me
DB_DRIVER=com.mysql.cj.jdbc.Driver
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
ENCRYPTION_MASTER_KEY=replace-with-a-random-encryption-key-at-least-32-characters
ENCRYPTION_ENABLED=true
FLYWAY_ENABLED=true
SQL_INIT_MODE=never
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DL_ENGINE_ENABLED=true
DL_ENGINE_URL=http://127.0.0.1:5001
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS_PER_MINUTE=120
LOG_LEVEL=INFO
